        .controls label { font-weight: bold; color: #34495e; }
        .controls select, .controls button {
            padding: 8px 12px;
            border-radius: 4px;
            border: 1px solid #bdc3c7;
            cursor: pointer;
        }

        /* --- Tabellen Stil --- */
        table { 
            width: 100%; 
            border-collapse: collapse; 
            margin-top: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            background-color: white;
        }
        th, td { 
            border: 1px solid #ddd; 
            padding: 8px; 
            text-align: left;
            vertical-align: top;
        }
        th { 
            background-color: #3498db; /* Hellblau für Kopfzeile */
            color: white;
            font-weight: bold;
            position: sticky; 
            top: 0;
            z-index: 10;
        }
        tr:nth-child(even) { 
            background-color: #f8f8f8; 
        }
        
        /* --- Editierbarer Stil (Wird jetzt ignoriert, da contenteditable entfernt wurde) --- */
        /* [contenteditable="true"]:focus {
            outline: 2px solid #e74c3c; 
            background-color: #ffeaea; 
        } */
        
