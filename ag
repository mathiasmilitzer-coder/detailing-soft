    <script>
        // --- Konstanten ---
        const USt_SATZ = 1.19;

        // --- 1. Initialisierung der Filteroptionen ---
        document.addEventListener('DOMContentLoaded', () => {
            const table = document.getElementById('dataTable');
            const rows = table.querySelectorAll('tbody tr');
            const fahrzeugarten = new Set();
            const orte = new Set();

            rows.forEach(row => {
                const fzArt = row.getAttribute('data-fahrzeugart');
                const ort = row.getAttribute('data-ort');
                if (fzArt) fahrzeugarten.add(fzArt);
                if (ort) orte.add(ort);
            });

            // Füllt die Select-Box für Fahrzeugarten
            const filterFzArt = document.getElementById('filterFahrzeugart');
            [...fahrzeugarten].sort().forEach(art => {
                const option = document.createElement('option');
                option.value = art;
                option.textContent = art === 'NA' ? 'Sonstige/Unbekannt' : art;
                filterFzArt.appendChild(option);
            });

            // Füllt die Select-Box für Orte
            const filterOrt = document.getElementById('filterOrt');
            [...orte].sort().forEach(ort => {
                const option = document.createElement('option');
                option.value = ort;
                option.textContent = ort === '' ? 'Unspezifiziert' : ort;
                filterOrt.appendChild(option);
            });
            
            // Initiales Setzen der Brutto-Preise (Dies ist nicht mehr relevant für die Bearbeitung, 
            // aber es stellt sicher, dass die Brutto-Preise korrekt angezeigt werden)
            rows.forEach(row => {
                 const nettoCell = row.querySelector('.editable-price');
                 if (nettoCell) {
                     // Da die Zellen nicht mehr bearbeitbar sind, brauchen wir kein oninput-Event.
                     // Die JavaScript-Funktion zum Neuberechnen wird nicht mehr benötigt/aufgerufen.
                     // Ich entferne den Aufruf hier, da die Preise statisch im HTML stehen und 
                     // die Zellen nicht mehr bearbeitbar sind.
                     // updateBrutto(nettoCell); 
                 }
            });
        });

        // --- 2. Filterfunktion ---
        window.filterTable = function() {
            const selectedFzArt = document.getElementById('filterFahrzeugart').value;
            const selectedOrt = document.getElementById('filterOrt').value;
            const table = document.getElementById('dataTable');
            const rows = table.querySelectorAll('tbody tr');

            rows.forEach(row => {
                const fzArt = row.getAttribute('data-fahrzeugart');
                const ort = row.getAttribute('data-ort');

                const matchesFzArt = !selectedFzArt || fzArt === selectedFzArt;
                const matchesOrt = !selectedOrt || ort === selectedOrt;

                if (matchesFzArt && matchesOrt) {
                    row.style.display = ''; // Zeige Zeile
                } else {
                    row.style.display = 'none'; // Verstecke Zeile
                }
            });
        };

        // --- 3. Update Brutto-Preis Funktion ---
        // Die Funktion ist jetzt irrelevant, da keine Bearbeitung möglich ist, 
        // wird aber aus Kompatibilitätsgründen beibehalten, falls sie noch woanders gebraucht würde.
        // Sie wird aber nicht mehr über oninput im HTML aufgerufen.
        window.updateBrutto = function(nettoCell) {
            const nettoValueText = nettoCell.textContent.replace(',', '.'); // Komma durch Punkt ersetzen
            const nettoPrice = parseFloat(nettoValueText);
            
            // Die Brutto-Zelle ist die nächste Zelle (Index + 1)
            const bruttoCell = nettoCell.nextElementSibling;

            if (!isNaN(nettoPrice)) {
                // Brutto = Netto * 1.19
                const bruttoPrice = nettoPrice * USt_SATZ;
                // Auf zwei Dezimalstellen runden und Komma zurück
                bruttoCell.textContent = bruttoPrice.toFixed(2).replace('.', ',');
            } else {
                bruttoCell.textContent = "Ungültig";
            }
        };
    </script>

